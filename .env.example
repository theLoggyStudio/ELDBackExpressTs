# =============================================================================
# ELDBack — copier vers `.env` et remplir chaque valeur nécessaire au déploiement
# =============================================================================

# --- Serveur ---
PORT=4000
# development | production (souvent imposé par l’hébergeur, ex. Vercel)
NODE_ENV=development

# --- Sécurité ---
JWT_SECRET=

# --- Base de données (Sequelize) — une URL suffit en général ---
DATABASE_URL=

# --- Optionnel : variables fournies par certains hébergeurs (Neon, Vercel Postgres, etc.) ---
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# =============================================================================
# PayDunya (facturation checkout côté serveur)
# =============================================================================
# Seul interrupteur de mode: test (sandbox) ou production (live)
PAYDUNYA_MODE=production
PAYDUNIA_MASTER_KEY=
PAYDUNIA_TEST_URL=https://app.paydunya.com/sandbox-api/v1/checkout-invoice/create
PAYDUNIA_TEST_PUBLIC_KEY=
PAYDUNIA_TEST_PRIVATE_KEY=
PAYDUNIA_TEST_TOKEN=

PAYDUNIA_PRODUCTION_URL=https://app.paydunya.com/api/v1/checkout-invoice/create
PAYDUNIA_PRODUCTION_PUBLIC_KEY=
PAYDUNIA_PRODUCTION_PRIVATE_KEY=
PAYDUNIA_PRODUCTION_TOKEN=
# Pays ISO (alpha-2) suivis pour information / reporting.
# Le checkout de l'application passe desormais par PayDunya pour tous les pays.
PAYDUNYA_COUNTRY_CODES=SN,CI,ML,BJ,BF,TG,NE,GN,LR,SL,CM,GA,CG,TD,CF,CD,GH,NG

# =============================================================================
# Taux de change indicatifs (devises → FCFA sauf NGN)
# — NGN : FX_NGN_PER_FCFA = nairas pour 1 FCFA
# =============================================================================
FX_FCFA_PER_EUR=655.957
FX_FCFA_PER_USD=620
FX_FCFA_PER_GBP=780
FX_FCFA_PER_CHF=700
FX_FCFA_PER_MAD=60
FX_FCFA_PER_DZD=4.5
FX_FCFA_PER_XAF=655.957
FX_FCFA_PER_GHS=45
FX_NGN_PER_FCFA=0.27

# =============================================================================
# Dohone (pays listés dans DOHONE_COUNTRY_CODES — priorité sur PayDunya)
# =============================================================================
DOHONE_API_URL=https://www.dohone.com/dohone-api/v1
# Numéro marchand (rN) — ne jamais exposer côté front
DOHONE_MERCHANT_RN=
# Type de paiement (rT), ex. MOBILE
DOHONE_PAYMENT_RT=MOBILE
# Devise API (ex. XAF pour la zone CEMAC)
DOHONE_CURRENCY=XAF
# Pays ISO pour lesquels utiliser Dohone en priorité (séparateur virgule)
DOHONE_COUNTRY_CODES=GA,TD,CF,CG,GQ
